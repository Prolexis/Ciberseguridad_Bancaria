{
  "name": "AegisBank - 01 Ingestión Programada de Feeds y Datasets Públicos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Cron Trigger (Cada 4 Horas)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://data.phishtank.com/data/online-valid.json",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        },
        "headerParametersUi": {
          "parameter": [
            {
              "name": "User-Agent",
              "value": "AegisBank-Security-ETL/1.0"
            }
          ]
        }
      },
      "id": "node-http-phishtank",
      "name": "HTTP Request: PhishTank Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filtrar URLs que intentan suplantar bancos y sanitizar registros\nconst items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const data = item.json;\n  if (data && data.url && (data.verified === 'yes' || data.verified === true)) {\n    results.push({\n      json: {\n        url: data.url,\n        phish_id: data.phish_id,\n        target: data.target || 'Desconocido',\n        verified: true,\n        ingestion_time: new Date().toISOString()\n      }\n    });\n  }\n}\nreturn results.slice(0, 500);"
      },
      "id": "node-code-filter",
      "name": "Filtrar y Sanitizar Registros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/datasets/ingest-batch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"dataset_name\": \"PhishTank-Validated-Feed\",\n  \"records\": $json\n}",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "X-Aegis-Auth",
              "value": "n8n_sec_vault_token_placeholder"
            }
          ]
        }
      },
      "id": "node-post-backend",
      "name": "POST a Backend ETL Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "channel": "#soc-telemetria",
        "text": "=✅ *ETL Phishing Feed Completado con Éxito*\n- Dataset: `PhishTank-Validated-Feed`\n- Registros procesados y cargados: {{ $json.total_loaded || 500 }}\n- Timestamp: {{ new Date().toISOString() }}"
      },
      "id": "node-slack-notify",
      "name": "Notificación Slack SOC",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Cron Trigger (Cada 4 Horas)": {
      "main": [
        [
          {
            "node": "HTTP Request: PhishTank Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request: PhishTank Feed": {
      "main": [
        [
          {
            "node": "Filtrar y Sanitizar Registros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar y Sanitizar Registros": {
      "main": [
        [
          {
            "node": "POST a Backend ETL Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST a Backend ETL Pipeline": {
      "main": [
        [
          {
            "node": "Notificación Slack SOC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

